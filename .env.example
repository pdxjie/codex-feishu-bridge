# 飞书企业自建应用凭证
FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx

# 逗号分隔的管理员 open_id。管理员可以控制本机 Codex Desktop 的全部授权项目和会话。
FEISHU_ALLOWED_OPEN_IDS=ou_xxxxxxxxxxxxx

# 开启后，非管理员用户自动进入隔离的只读访客模式。企业自建应用仍应只对本企业成员可见。
FEISHU_GUEST_MODE_ENABLED=false
# 可选的飞书企业 tenant_key；配置后会拒绝其他企业用户。
# FEISHU_TENANT_KEY=xxxxxxxxxxxxxxxx

# 访客唯一可读取的 ERP 项目目录。
GUEST_WORKSPACE_ROOT=/Users/your-name/Projects/mc
# 访客执行器的隔离 HOME（临时文件和最小配置）；项目/会话索引仍与 Desktop 共享以实现实时可见。
GUEST_CODEX_HOME=./data/guest-codex-home
# 现有 MC 只读数据库连接配置；指定连接必须同时标记 production 和 readonly。
GUEST_DB_CONFIG_PATH=/Users/your-name/.config/mc-ai/connections.json
GUEST_DB_CONNECTION=production
GUEST_MAX_CONCURRENT_TURNS=4

# 可选：覆盖 Codex 可执行文件。macOS 桌面版会自动发现内置 Codex CLI。
# CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex

# 新会话允许选择的工作目录根路径，逗号分隔。
ALLOWED_WORKSPACE_ROOTS=/Users/your-name/Projects

# 默认新会话目录。必须位于 ALLOWED_WORKSPACE_ROOTS 内。
DEFAULT_WORKSPACE=/Users/your-name/Projects

# 本地状态数据库
STATE_DB_PATH=./data/state.db

# 日志级别：debug / info / warn / error
LOG_LEVEL=info
