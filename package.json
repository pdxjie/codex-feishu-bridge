{
  "name": "codex-feishu-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "A local bridge that controls Codex sessions from a Feishu bot.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "codex:check": "tsx src/doctor.ts"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.58.0",
    "dotenv": "^17.2.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
